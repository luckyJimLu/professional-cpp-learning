{
  "name": "professional-cpp-learning-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "preview": "vite preview",
    "prepare:clang": "clang-wasm-copy-assets public/clang",
    "predev": "npm run prepare:clang",
    "prebuild": "npm run prepare:clang",
    "test:e2e": "playwright test",
    "check:examples": "python3 tools/check-examples.py",
    "check:course": "python3 tools/check-course.py",
    "check:migration": "python3 tools/check-migration.py",
    "check:reference-cpp": "cd references/system-design-notes && bash scripts/check-cpp-examples.sh",
    "format:cpp": "python3 tools/format-markdown-cpp.py --all",
    "format:cpp:check": "python3 tools/format-markdown-cpp.py --all --check",
    "ppt:sync": "cp -r .opencode/skills/slidev-ppt/assets/theme/. slides/",
    "ppt:install": "npm install --prefix slides --no-audit --no-fund",
    "ppt:check": "python3 tools/check-slides.py",
    "ppt:check:strict": "python3 tools/check-slides.py --strict",
    "ppt:build": "npm --prefix slides run build",
    "ppt:export": "npm --prefix slides run export",
    "ppt:all": "npm run ppt:sync && npm run ppt:check && npm run ppt:build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@lezer/common": "^1.5.3",
    "@lezer/cpp": "^1.1.6",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@live-codes/clang-wasm": "0.2.0",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.12.0",
    "plantuml-encoder": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
