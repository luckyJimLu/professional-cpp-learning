{
  "name": "professional-cpp-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:clang": "node scripts/prepare-clang.mjs",
    "build:content": "python3 scripts/build-content.py --out public/content",
    "predev": "npm run prepare:clang && npm run build:content",
    "dev": "vite",
    "prebuild": "npm run prepare:clang && npm run build:content",
    "build": "tsc --noEmit && vite build",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint src",
    "check:course": "python3 tools/check-course.py",
    "check:booklets": "python3 tools/check-booklets.py",
    "check:migration": "python3 tools/check-migration.py",
    "check:examples": "python3 tools/check-examples.py",
    "ppt:check": "python3 tools/check-slides.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/common": "^1.2.3",
    "@lezer/cpp": "^1.1.3",
    "@live-codes/clang-wasm": "^0.2.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.511.0",
    "mermaid": "^11.6.0",
    "plantuml-encoder": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5"
  }
}
