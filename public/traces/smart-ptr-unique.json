{
  "id": "smart-ptr-unique",
  "title": "std::unique_ptr 独占所有权与移动语义",
  "category": "smart_pointers",
  "description": "展示现代 C++ 中 std::unique_ptr 的独占性、std::move() 所有权转移以及离开作用域时的自动析构与堆内存回收。",
  "sourceCode": "#include <iostream>\n#include <memory>\n\nstruct Widget {\n    int id;\n    Widget(int v) : id(v) { std::cout << \"Widget(\" << id << \") created\\n\"; }\n    ~Widget() { std::cout << \"Widget(\" << id << \") destroyed\\n\"; }\n};\n\nint main() {\n    std::cout << \"--- Step 1: 创建 unique_ptr p1 ---\\n\";\n    auto p1 = std::make_unique<Widget>(42);\n\n    std::cout << \"--- Step 2: 转移所有权到 p2 ---\\n\";\n    std::unique_ptr<Widget> p2 = std::move(p1);\n\n    std::cout << \"--- Step 3: p1 已置空，p2 掌管堆内存 ---\\n\";\n    if (!p1) {\n        std::cout << \"p1 is now nullptr\\n\";\n    }\n\n    std::cout << \"--- Step 4: 退出作用域，自动回收堆内存 ---\\n\";\n    return 0;\n}",
