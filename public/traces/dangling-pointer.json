  "category": "memory_safety",
  "description": "内存安全核心案例：观察指针在堆对象已被 delete 之后依然保存旧地址的情况（野指针/悬挂指针 Dangling Pointer），以及丢失堆指针造成的内存泄漏。",
  "sourceCode": "#include <iostream>\n\nstruct Buffer {\n    int data;\n    Buffer(int d) : data(d) { std::cout << \"Allocated\\n\"; }\n    ~Buffer() { std::cout << \"Deallocated\\n\"; }\n};\n\nint main() {\n    std::cout << \"--- Step 1: new 分配堆内存 ---\\n\";\n    Buffer* ptr = new Buffer(99);\n\n    std::cout << \"--- Step 2: delete 释放堆内存 ---\\n\";\n    delete ptr; // 堆内存已销毁，但 ptr 仍持有旧地址 0x5010！\n\n    std::cout << \"--- Step 3: 产生悬挂指针 (Dangling Pointer) ---\\n\";\n    // ptr->data = 100; // 未定义行为 (UB)\n\n    std::cout << \"--- Step 4: 最佳实践：置空 nullptr ---\\n\";\n    ptr = nullptr;\n\n    return 0;\n}",
