{
  "name": "professional-cpp-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev lesson-01.md --open",
    "build": "npm run build:01 && npm run build:02 && npm run build:03",
    "export": "slidev export lesson-01.md --output dist/lesson-01.pdf",
    "dev:02": "slidev lesson-02.md --open",
    "build:02": "slidev build lesson-02.md --out dist/lesson-02",
    "export:02": "slidev export lesson-02.md --output dist/lesson-02.pdf",
    "build:all": "npm run build",
    "build:01": "slidev build lesson-01.md --out dist/lesson-01",
    "dev:03": "slidev lesson-03.md --open",
    "build:03": "slidev build lesson-03.md --out dist/lesson-03",
    "export:03": "slidev export lesson-03.md --output dist/lesson-03.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.64.1"
  }
}
